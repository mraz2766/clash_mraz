#!/bin/sh
set -eu
# Mac checks use the installed toolchain without downloading cargo-make.
export PATH="$HOME/.cargo/bin:$PATH"
cargo fmt --all -- --check
if ! git diff --cached --quiet -- src/locales crates/clash-verge-i18n/locales; then
  node scripts/cleanup-unused-i18n.mjs --align --apply
  node scripts/generate-i18n-keys.mjs
  git add src/locales crates/clash-verge-i18n/locales src/types/generated
fi
./node_modules/.bin/lint-staged
