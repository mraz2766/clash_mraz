#!/bin/sh
set -eu

# GUI Git clients do not load the interactive shell's Rust PATH.
export PATH="$HOME/.cargo/bin:$PATH"

# Keep the existing policy: compare subsequent pushes with the upstream.
# Publishing a branch for the first time has no upstream comparison yet.
if ! upstream=$(git rev-parse --verify '@{u}' 2>/dev/null); then
  echo "No upstream found; skipping diff-based pre-push checks."
  exit 0
fi

if ! git diff --quiet "$upstream" HEAD -- '*.rs' Cargo.toml Cargo.lock ':(glob)**/Cargo.toml'; then
  cargo clippy --all-targets --all-features -- -D warnings
fi
if ! git diff --quiet "$upstream" HEAD -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.css' '*.scss' '*.html'; then
  ./node_modules/.bin/tsc --noEmit
  ./node_modules/.bin/knip
fi
